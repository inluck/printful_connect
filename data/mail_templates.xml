<?xml version="1.0" ?>
<odoo>
    <data noupdate="1">
        <record id="mail_template_printful_order_confirmed" model="mail.template">
            <field name="name">Printful: Order Confirmed</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="subject">Your order {{ object.name }} is confirmed!</field>
            <field name="email_from">{{ (object.company_id.email or object.user_id.email_formatted or user.email_formatted) }}</field>
            <field name="email_to">{{ object.partner_id.email }}</field>
            <field name="description">Sent when an order is pushed to Printful for fulfillment</field>
            <field name="body_html" type="html">
<div style="margin: 0px; padding: 0px;">
    <p style="margin: 0px; padding: 0px; font-size: 13px;">
        Hi <t t-out="object.partner_id.name or ''">Customer</t>,
        <br/><br/>
        Your order <span style="font-weight: bold;" t-out="object.name or ''">SO001</span> has been confirmed.
        <br/><br/>
        Thank you for your order!
    </p>
</div>
            </field>
            <field name="auto_delete" eval="True"/>
        </record>
    </data>
</odoo>
