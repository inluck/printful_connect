<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Process sync queue items in batches -->
        <record id="cron_process_sync_queue" model="ir.cron">
            <field name="name">Printful: Process Sync Queue</field>
            <field name="model_id" ref="model_printful_sync_queue"/>
            <field name="state">code</field>
            <field name="code">
# First, recover any stale queues (stuck for more than 30 minutes)
model._recover_stale_queues(stale_timeout_minutes=30)

# Process running queues in batches
running_queues = model.search([('state', '=', 'running')])
for queue in running_queues:
    queue.action_process_next_batch(batch_size=5)
            </field>
            <field name="interval_number">2</field>
            <field name="interval_type">minutes</field>
            <field name="numbercall">-1</field>
            <field name="doall" eval="False"/>
            <field name="priority">100</field>
            <field name="active" eval="True"/>
        </record>

        <!-- Process pending webhook events -->
        <record id="cron_process_webhook_events" model="ir.cron">
            <field name="name">Printful: Process Webhook Events</field>
            <field name="model_id" ref="model_printful_webhook_event"/>
            <field name="state">code</field>
            <field name="code">model.process_pending_events()</field>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="numbercall">-1</field>
            <field name="doall" eval="False"/>
            <field name="priority">110</field>
            <field name="active" eval="True"/>
        </record>

        <!-- Cleanup expired shipping rate cache -->
        <record id="cron_cleanup_shipping_cache" model="ir.cron">
            <field name="name">Printful: Cleanup Shipping Rate Cache</field>
            <field name="model_id" ref="model_printful_shipping_rate"/>
            <field name="state">code</field>
            <field name="code">model.cleanup_expired()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="numbercall">-1</field>
            <field name="doall" eval="False"/>
            <field name="priority">200</field>
            <field name="active" eval="True"/>
        </record>

        <!-- Legacy: Full product sync (runs hourly, disabled by default) -->
        <record id="auto_create_product_cron" model="ir.cron">
            <field name="name">Printful: Legacy Full Sync (Hourly)</field>
            <field name="model_id" ref="model_printful_printful"/>
            <field name="state">code</field>
            <field name="code">
# Legacy sync - processes all products synchronously
# Consider using the queue system instead for large catalogs
for config in model.search([]):
    config.action_get_printful_products()
            </field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="numbercall">-1</field>
            <field name="doall" eval="False"/>
            <field name="priority">1000</field>
            <field name="active" eval="False"/>
        </record>
    </data>
</odoo>
