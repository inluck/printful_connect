<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Estimated Delivery on Product Page -->
    <template id="s_estimated_delivery" name="Estimated Delivery" inherit_id="website_sale.product" customize_show="True">
        <xpath expr="//div[@id='product_details']//div[hasclass('js_product')]" position="inside">
            <div class="estimated-delivery mt-3" t-if="product.printful_shipping">
                <span class="text-muted">
                    <i class="fa fa-truck me-1" role="img" aria-label="Shipping"/>
                    Estimated Delivery: <strong t-out="product.printful_shipping"/>
                </span>
            </div>
        </xpath>
    </template>

    <!-- Size Guide Section on Product Page -->
    <template id="s_size_guide" name="Size Guide" inherit_id="website_sale.product" customize_show="True">
        <xpath expr="//div[@id='product_full_description']" position="after">
            <div class="size-guide mt-4" t-if="product.printful_sizeguide">
                <h3 class="mb-3">Size Guide</h3>
                <div class="table-responsive">
                    <!-- t-out with Markup for trusted HTML content -->
                    <t t-out="product.printful_sizeguide"/>
                </div>
            </div>
        </xpath>
    </template>
</odoo>
