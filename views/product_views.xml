<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Product Variant Form Extension -->
    <record model="ir.ui.view" id="product_normal_form_view">
        <field name="name">product.product.form.inherit.printful</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Printful Info" name="printful_info">
                    <group>
                        <field name="printful_product"/>
                        <field name="printful_variant_id" readonly="1"/>
                        <field name="printful_variant_ref" readonly="1"/>
                        <field name="printful_variant_external_ref" readonly="1"/>
                        <field name="printful_product_in_stock"/>
                    </group>
                    <group>
                        <field name="printful_sku" readonly="1"/>
                        <field name="printful_currency" readonly="1"/>
                        <field name="printful_size" readonly="1"/>
                        <field name="printful_color" readonly="1"/>
                        <field name="printful_shipping" readonly="1"/>
                    </group>
                </group>
                <group string="Size Guide" name="printful_sizeguide"
                       invisible="not printful_sizeguide">
                    <field name="printful_sizeguide" nolabel="1" readonly="1"/>
                </group>
            </xpath>
        </field>
    </record>

    <!-- Product Template Form Extension -->
    <record model="ir.ui.view" id="product_template_form_view">
        <field name="name">product.template.form.inherit.printful</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Printful Info" name="printful_info">
                    <field name="printful_ref" readonly="1"/>
                    <field name="printful_external_ref" readonly="1"/>
                    <field name="printful_shipping" readonly="1"/>
                </group>
                <group string="Size Guide" name="printful_sizeguide"
                       invisible="not printful_sizeguide">
                    <field name="printful_sizeguide" nolabel="1" readonly="1"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
