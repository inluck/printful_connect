<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Sale Order Form Extension -->
    <record model="ir.ui.view" id="view_order_form">
        <field name="name">sale.order.form.inherit.printful</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <!-- Add Push to Printful button in header -->
            <xpath expr="//header/field[@name='state']" position="before">
                <button name="action_create_push_order_printful"
                        type="object"
                        class="btn-primary"
                        string="Push Order to Printful"
                        invisible="order_external_ref"/>
            </xpath>

            <!-- Add Printful tab to notebook -->
            <xpath expr="//notebook" position="inside">
                <page string="Printful" name="printful_tab">
                    <group>
                        <group string="Order Info">
                            <field name="printful_dashboard_url" widget="url" readonly="1"/>
                            <field name="order_ref" string="Printful ID" readonly="1"/>
                            <field name="order_external_ref" readonly="1"/>
                            <field name="order_store_ref" readonly="1"/>
                            <field name="order_shipping" readonly="1"/>
                            <field name="order_shipping_service_name" readonly="1"/>
                            <field name="printful_order_notes" readonly="1"/>
                        </group>
                        <group string="Costs Breakdown">
                            <field name="order_currency" readonly="1"/>
                            <field name="order_subtotal" readonly="1"/>
                            <field name="order_discount" readonly="1"/>
                            <field name="shipping" readonly="1"/>
                            <field name="order_digitization" readonly="1"/>
                            <field name="order_additional_fee" readonly="1"/>
                            <field name="order_fulfillment_fee" readonly="1"/>
                            <field name="order_retail_delivery_fee" readonly="1"/>
                            <field name="order_tax" readonly="1"/>
                            <field name="order_vat" readonly="1"/>
                            <field name="order_total" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <group string="Profit Breakdown">
                            <field name="customer_pays" readonly="1"/>
                            <field name="printful_price" readonly="1"/>
                            <field name="profit" readonly="1"/>
                            <field name="currency_symbol" readonly="1"/>
                        </group>
                    </group>
                </page>
                <page string="Tracking" name="tracking_tab">
                    <div class="row mb-3" invisible="not printful_tracking_number">
                        <div class="col-12">
                            <div class="alert alert-success mb-0">
                                <h4 class="alert-heading mb-2">Package Shipped!</h4>
                                <p class="mb-1">
                                    <strong>Carrier:</strong> <field name="printful_tracking_carrier" readonly="1" class="d-inline"/>
                                </p>
                                <p class="mb-1">
                                    <strong>Tracking Number:</strong> <field name="printful_tracking_number" readonly="1" class="d-inline"/>
                                </p>
                                <p class="mb-1" invisible="not printful_tracking_url">
                                    <a class="btn btn-primary btn-sm">
                                        <field name="printful_tracking_url" widget="url" readonly="1" text="Track Package"/>
                                    </a>
                                </p>
                            </div>
                        </div>
                    </div>
                    <group>
                        <group string="Fulfillment Status">
                            <field name="printful_fulfillment_status" readonly="1" widget="badge"
                                   decoration-info="printful_fulfillment_status == 'pending'"
                                   decoration-warning="printful_fulfillment_status == 'in_production'"
                                   decoration-success="printful_fulfillment_status in ('shipped', 'delivered')"
                                   decoration-danger="printful_fulfillment_status in ('failed', 'canceled', 'returned')"/>
                            <field name="printful_shipped_at" readonly="1"/>
                            <field name="printful_estimated_delivery" readonly="1"/>
                        </group>
                        <group string="Tracking Details">
                            <field name="printful_tracking_carrier" readonly="1"/>
                            <field name="printful_tracking_number" readonly="1"/>
                            <field name="printful_tracking_url" widget="url" readonly="1"/>
                        </group>
                    </group>
                    <div class="alert alert-info" invisible="printful_tracking_number">
                        <strong>No tracking information available yet.</strong><br/>
                        Tracking details will appear here once the package has been shipped.
                    </div>
                </page>
            </xpath>

        </field>
    </record>

    <!-- Partner Form Extension -->
    <record model="ir.ui.view" id="view_partner_form">
        <field name="name">res.partner.form.inherit.printful</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='vat']" position="after">
                <field name="tax_number"/>
            </xpath>
        </field>
    </record>
</odoo>
