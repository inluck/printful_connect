<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_printful_form" model="ir.ui.view">
        <field name="name">printful.printful.form</field>
        <field name="model">printful.printful</field>
        <field name="arch" type="xml">
            <form string="Printful Store">
                <header>
                    <button name="action_create_sync_queue"
                            type="object"
                            class="btn-primary"
                            string="Create Sync Queue"
                            icon="fa-plus"/>
                    <button name="action_get_printful_products"
                            type="object"
                            class="btn-secondary"
                            string="Quick Sync (Legacy)"/>
                    <button name="action_get_printful_order"
                            type="object"
                            class="btn-secondary"
                            string="Fetch Orders"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="%(printful_sync_queue_action)d"
                                type="action"
                                class="oe_stat_button"
                                icon="fa-refresh"
                                context="{'search_default_printful_config_id': id}">
                            <field name="sync_queue_ids" widget="statinfo" string="Sync Queues"/>
                        </button>
                        <button name="%(printful_webhook_event_action)d"
                                type="action"
                                class="oe_stat_button"
                                icon="fa-bell"
                                context="{'search_default_printful_config_id': id}">
                            <span class="o_stat_text">Webhook Events</span>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Store Name"/></h1>
                    </div>
                    <notebook>
                        <page string="Configuration" name="config">
                            <group>
                                <group string="API Configuration">
                                    <field name="token" password="True" placeholder="Printful API Token"/>
                                    <field name="api_version"/>
                                    <field name="currency_id" options="{'no_create': True}"/>
                                </group>
                                <group string="Product Attributes">
                                    <field name="size_attribute_id"/>
                                    <field name="color_attribute_id"/>
                                </group>
                            </group>
                            <group>
                                <group string="Order Fulfillment">
                                    <field name="auto_fulfill_orders"/>
                                    <div colspan="2" class="text-muted small" invisible="not auto_fulfill_orders">
                                        When enabled, orders containing Printful products will be automatically
                                        sent to Printful for fulfillment upon confirmation.
                                    </div>
                                </group>
                                <group string="Defaults">
                                    <field name="product_public_category_id"/>
                                    <field name="multiple_product_images"/>
                                </group>
                            </group>
                        </page>
                        <page string="Shipping Methods" name="shipping">
                            <group>
                                <group>
                                    <field name="default_shipping_method_id" readonly="1"/>
                                </group>
                                <group string="Cache Settings">
                                    <field name="shipping_cache_ttl"/>
                                </group>
                            </group>
                            <field name="shipping_method_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="printful_method_id"/>
                                    <field name="delivery_carrier_id"/>
                                    <field name="is_default"/>
                                    <field name="fixed_surcharge"/>
                                    <field name="percentage_markup"/>
                                    <field name="active"/>
                                </list>
                            </field>
                        </page>
                        <page string="Default Addresses" name="addresses">
                            <div class="alert alert-info" role="alert">
                                <strong>Default Addresses</strong> are used for shipping estimates during product sync.
                                Configure a realistic address for your primary market to get accurate delivery estimates.
                            </div>
                            <group>
                                <field name="primary_default_address_id" readonly="1"/>
                            </group>
                            <field name="default_address_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="country_id"/>
                                    <field name="state_id"/>
                                    <field name="city"/>
                                    <field name="zip_code"/>
                                    <field name="address1"/>
                                    <field name="is_primary"/>
                                    <field name="active"/>
                                </list>
                            </field>
                        </page>
                        <page string="Webhooks" name="webhooks">
                            <div class="alert alert-info" role="alert">
                                <strong>Webhooks</strong> allow Printful to notify Odoo about order status changes, shipments, and product updates in real-time.
                                Click "Register with Printful" to automatically configure the webhook - no manual setup required!
                            </div>
                            <field name="webhook_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="is_registered" widget="boolean"/>
                                    <field name="webhook_url"/>
                                    <field name="last_received_at"/>
                                    <field name="events_received_count"/>
                                    <field name="events_failed_count"/>
                                    <field name="active"/>
                                </list>
                                <form>
                                    <header>
                                        <button name="action_register_webhook" type="object" string="Register with Printful" class="btn-primary" icon="fa-cloud-upload"/>
                                        <button name="action_unregister_webhook" type="object" string="Unregister" class="btn-secondary" icon="fa-cloud-download" invisible="not is_registered"/>
                                        <button name="action_sync_webhook_status" type="object" string="Sync Status" class="btn-secondary" icon="fa-refresh"/>
                                    </header>
                                    <sheet>
                                        <div class="oe_button_box" name="button_box">
                                            <button class="oe_stat_button" disabled="1" icon="fa-check-circle" invisible="not is_registered">
                                                <div class="o_stat_info">
                                                    <span class="o_stat_text text-success">Registered</span>
                                                </div>
                                            </button>
                                            <button class="oe_stat_button" disabled="1" icon="fa-times-circle" invisible="is_registered">
                                                <div class="o_stat_info">
                                                    <span class="o_stat_text text-muted">Not Registered</span>
                                                </div>
                                            </button>
                                        </div>
                                        <group>
                                            <group string="Configuration">
                                                <field name="name"/>
                                                <field name="active"/>
                                                <field name="webhook_url" readonly="1" widget="CopyClipboardChar"/>
                                                <field name="expires_at"/>
                                            </group>
                                            <group string="Registration Status">
                                                <field name="is_registered" readonly="1"/>
                                                <field name="registered_at" readonly="1"/>
                                                <field name="webhook_secret" password="True" readonly="1"/>
                                                <field name="public_key" readonly="1" invisible="not public_key"/>
                                            </group>
                                        </group>
                                        <group string="Subscribed Events">
                                            <group>
                                                <field name="event_order_created"/>
                                                <field name="event_order_updated"/>
                                                <field name="event_order_failed"/>
                                                <field name="event_order_canceled"/>
                                                <field name="event_package_shipped"/>
                                            </group>
                                            <group>
                                                <field name="event_package_returned"/>
                                                <field name="event_product_synced"/>
                                                <field name="event_product_updated"/>
                                                <field name="event_product_deleted"/>
                                                <field name="event_stock_updated"/>
                                            </group>
                                        </group>
                                        <group string="Statistics">
                                            <group>
                                                <field name="last_received_at"/>
                                                <field name="events_received_count"/>
                                            </group>
                                            <group>
                                                <field name="events_failed_count"/>
                                            </group>
                                        </group>
                                    </sheet>
                                    <footer>
                                        <button name="action_test_webhook" type="object" string="Show Webhook URL (Manual)" class="btn-link"/>
                                    </footer>
                                </form>
                            </field>
                        </page>
                        <page string="Branding" name="branding">
                            <div class="alert alert-info" role="alert">
                                <strong>Custom Branding</strong> allows you to personalize packing slips and gift messages
                                sent with your Printful orders.
                            </div>
                            <group>
                                <group string="Packing Slip">
                                    <field name="packing_slip_store_name" placeholder="Your Store Name"/>
                                    <field name="packing_slip_email" placeholder="support@yourstore.com"/>
                                    <field name="packing_slip_phone" placeholder="+1 234 567 8900"/>
                                    <field name="packing_slip_logo_url" placeholder="https://yoursite.com/logo.png"/>
                                    <field name="packing_slip_message" placeholder="Thank you for your order! We hope you love your purchase."/>
                                </group>
                                <group string="Gift Options">
                                    <field name="gift_message_default" placeholder="Thank you for your purchase!"/>
                                </group>
                            </group>
                            <div class="alert alert-warning" role="alert">
                                <strong>Logo URL Requirements:</strong>
                                <ul class="mb-0">
                                    <li>Must be a publicly accessible HTTPS URL</li>
                                    <li>Recommended size: 600x100 pixels</li>
                                    <li>Supported formats: PNG, JPG</li>
                                </ul>
                            </div>
                        </page>
                        <page string="SEO Settings" name="seo">
                            <div class="alert alert-info" role="alert">
                                <strong>SEO Settings</strong> control how product metadata is generated during sync
                                for better search engine visibility.
                            </div>
                            <group>
                                <group string="SEO Configuration">
                                    <field name="seo_auto_populate"/>
                                </group>
                            </group>
                            <group invisible="not seo_auto_populate">
                                <group string="Meta Title Template">
                                    <field name="seo_title_template" placeholder="{product_name} | {brand}"/>
                                    <div class="text-muted small">
                                        Available variables: {product_name}, {brand}, {type}
                                    </div>
                                </group>
                                <group string="Meta Description Template">
                                    <field name="seo_description_template" placeholder="Shop {product_name} by {brand}. {description_short}"/>
                                    <div class="text-muted small">
                                        Available variables: {product_name}, {brand}, {type}, {description_short}
                                    </div>
                                </group>
                            </group>
                            <div class="alert alert-secondary mt-3" role="alert" invisible="not seo_auto_populate">
                                <strong>Example Output:</strong><br/>
                                Title: "Unisex Staple T-Shirt | Bella + Canvas"<br/>
                                Description: "Shop Unisex Staple T-Shirt by Bella + Canvas. A soft and comfortable..."
                            </div>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_printful_list" model="ir.ui.view">
        <field name="name">printful.printful.tree</field>
        <field name="model">printful.printful</field>
        <field name="arch" type="xml">
            <list>
                <header>
                    <button name="action_get_all_printful_products"
                            type="object"
                            class="btn-secondary"
                            string="Quick Sync All (Legacy)"/>
                </header>
                <field name="name"/>
                <field name="size_attribute_id"/>
                <field name="color_attribute_id"/>
                <button name="action_create_sync_queue"
                        type="object"
                        string="Create Queue"
                        icon="fa-plus"
                        class="btn-link"/>
            </list>
        </field>
    </record>

    <record id="action_printful_view" model="ir.actions.act_window">
        <field name="name">Printful Stores</field>
        <field name="res_model">printful.printful</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Configure your first Printful store
            </p>
            <p>
                Add your Printful API token to start syncing products.
                Use the queue system for better visibility and control over large syncs.
            </p>
        </field>
    </record>

    <!-- Keep legacy menu item for backward compatibility -->
    <menuitem action="action_printful_view"
              id="action_printful_root"
              parent="stock.menu_stock_config_settings"
              sequence="20"
              name="Printful Stores"/>

    <!-- Printful Stores menu under Configuration (parent defined in printful_sync_queue_views.xml) -->
    <menuitem id="menu_printful_stores"
              name="Printful Stores"
              parent="menu_printful_config"
              action="action_printful_view"
              sequence="10"/>
</odoo>
